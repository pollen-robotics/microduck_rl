{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microduck.dev/schemas/microduck-policy-bundle-v1.schema.json",
  "$defs": {
    "ActionContract": {
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "const": "MICRODUCK_ACTION_14_V1",
          "title": "Identifier",
          "type": "string"
        },
        "dimension": {
          "const": 14,
          "title": "Dimension",
          "type": "integer"
        },
        "joints": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 14,
          "minItems": 14,
          "prefixItems": [
            {
              "const": "left_hip_yaw"
            },
            {
              "const": "left_hip_roll"
            },
            {
              "const": "left_hip_pitch"
            },
            {
              "const": "left_knee"
            },
            {
              "const": "left_ankle"
            },
            {
              "const": "neck_pitch"
            },
            {
              "const": "head_pitch"
            },
            {
              "const": "head_yaw"
            },
            {
              "const": "head_roll"
            },
            {
              "const": "right_hip_yaw"
            },
            {
              "const": "right_hip_roll"
            },
            {
              "const": "right_hip_pitch"
            },
            {
              "const": "right_knee"
            },
            {
              "const": "right_ankle"
            }
          ],
          "title": "Joints",
          "type": "array"
        },
        "units": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Units",
          "type": "string"
        },
        "scaling": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxProperties": 128,
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Scaling",
          "type": "object",
          "x-unergy-invariants": {
            "finiteNumbers": true,
            "maxCanonicalJsonBytes": 65536,
            "maxDepth": 8
          }
        },
        "clipping": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxProperties": 128,
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Clipping",
          "type": "object",
          "x-unergy-invariants": {
            "finiteNumbers": true,
            "maxCanonicalJsonBytes": 65536,
            "maxDepth": 8
          }
        }
      },
      "required": [
        "identifier",
        "dimension",
        "joints",
        "units",
        "scaling",
        "clipping"
      ],
      "title": "ActionContract",
      "type": "object"
    },
    "ActionDefinition": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "AVAILABLE"
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "properties": {
              "policyRef": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "policyRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "executionMode": {
                "const": "CONTINUOUS_LEASE"
              }
            },
            "required": [
              "executionMode"
            ]
          },
          "then": {
            "properties": {
              "lease": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "lease"
            ]
          }
        }
      ],
      "properties": {
        "actionCode": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Actioncode",
          "type": "string"
        },
        "executionMode": {
          "enum": [
            "DISCRETE",
            "CONTINUOUS_LEASE"
          ],
          "title": "Executionmode",
          "type": "string"
        },
        "availability": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ],
          "title": "Availability",
          "type": "string"
        },
        "policyRef": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policyref"
        },
        "unavailableReason": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailablereason"
        },
        "parameterSchema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxProperties": 128,
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Parameterschema",
          "type": "object",
          "x-unergy-invariants": {
            "finiteNumbers": true,
            "maxCanonicalJsonBytes": 65536,
            "maxDepth": 8
          }
        },
        "completion": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompletionContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lease": {
          "anyOf": [
            {
              "$ref": "#/$defs/LeaseContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "displayName": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Displayname"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "localizedLabels": {
          "anyOf": [
            {
              "additionalProperties": {
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              },
              "maxProperties": 32,
              "propertyNames": {
                "maxLength": 128,
                "minLength": 1
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Localizedlabels"
        },
        "preconditions": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "maxProperties": 128,
              "propertyNames": {
                "maxLength": 128,
                "minLength": 1
              },
              "type": "object",
              "x-unergy-invariants": {
                "finiteNumbers": true,
                "maxCanonicalJsonBytes": 65536,
                "maxDepth": 8
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preconditions"
        },
        "safety": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "maxProperties": 128,
              "propertyNames": {
                "maxLength": 128,
                "minLength": 1
              },
              "type": "object",
              "x-unergy-invariants": {
                "finiteNumbers": true,
                "maxCanonicalJsonBytes": 65536,
                "maxDepth": 8
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Safety"
        },
        "qualificationRefs": {
          "anyOf": [
            {
              "items": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualificationrefs"
        }
      },
      "required": [
        "actionCode",
        "executionMode",
        "availability",
        "parameterSchema"
      ],
      "title": "ActionDefinition",
      "type": "object"
    },
    "CompletionContract": {
      "additionalProperties": false,
      "properties": {
        "terminalConditions": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Terminalconditions",
          "type": "array"
        },
        "maxDurationMs": {
          "exclusiveMinimum": 0,
          "maximum": 3600000,
          "title": "Maxdurationms",
          "type": "integer"
        }
      },
      "required": [
        "terminalConditions",
        "maxDurationMs"
      ],
      "title": "CompletionContract",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxItems": 256,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxProperties": 128,
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "LeaseContract": {
      "additionalProperties": false,
      "properties": {
        "minLeaseMs": {
          "exclusiveMinimum": 0,
          "maximum": 60000,
          "title": "Minleasems",
          "type": "integer"
        },
        "defaultLeaseMs": {
          "exclusiveMinimum": 0,
          "maximum": 60000,
          "title": "Defaultleasems",
          "type": "integer"
        },
        "maxLeaseMs": {
          "exclusiveMinimum": 0,
          "maximum": 60000,
          "title": "Maxleasems",
          "type": "integer"
        },
        "commandCadenceMs": {
          "exclusiveMinimum": 0,
          "maximum": 60000,
          "title": "Commandcadencems",
          "type": "integer"
        },
        "zeroCommand": {
          "additionalProperties": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "maximum": 9223372036854775807,
                "minimum": -9223372036854775808,
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 16,
          "propertyNames": {
            "maxLength": 64,
            "minLength": 1,
            "not": {
              "pattern": "[jJ][oO][iI][nN][tT]|[tT][oO][rR][qQ][uU][eE]|[pP][wW][mM]|[pP][oO][lL][iI][cC][yY][pP][aA][tT][hH]|[pP][oO][lL][iI][cC][yY][nN][aA][mM][eE]"
            }
          },
          "title": "Zerocommand",
          "type": "object",
          "x-unergy-invariants": {
            "finiteScalarsOnly": true,
            "maxCanonicalJsonBytes": 16384,
            "maxDepth": 1,
            "rejectPropertyNameSubstringsCaseInsensitive": [
              "joint",
              "torque",
              "pwm",
              "policyPath",
              "policyName"
            ]
          }
        },
        "safeStopBehavior": {
          "const": "ZERO_TWIST",
          "title": "Safestopbehavior",
          "type": "string"
        }
      },
      "required": [
        "minLeaseMs",
        "defaultLeaseMs",
        "maxLeaseMs",
        "commandCadenceMs",
        "zeroCommand",
        "safeStopBehavior"
      ],
      "title": "LeaseContract",
      "type": "object",
      "x-unergy-invariants": [
        "minLeaseMs <= defaultLeaseMs <= maxLeaseMs",
        "commandCadenceMs <= minLeaseMs"
      ]
    },
    "ModelArtifact": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "path",
        "digest"
      ],
      "title": "ModelArtifact",
      "type": "object"
    },
    "ObservationContract": {
