      "title": "Schema",
      "type": "string"
    },
    "bundleId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Bundleid",
      "type": "string"
    },
    "bundleVersion": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "title": "Bundleversion",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "sourceRepository": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Sourcerepository",
      "type": "string"
    },
    "sourceCommit": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Sourcecommit",
      "type": "string"
    },
    "robotModel": {
      "const": "MICRODUCK",
