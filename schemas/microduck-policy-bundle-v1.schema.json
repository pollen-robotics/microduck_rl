{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microduck.dev/schemas/microduck-policy-bundle-v1.schema.json",
  "title": "MicroDuck Policy Bundle V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundleId", "bundleVersion", "bundleDigest", "createdAt", "sourceRepository", "sourceCommit", "robotModel", "observationContract", "actionContract", "model", "policies", "actions", "qualification", "license"],
  "properties": {
    "schema": {"const": "MICRODUCK_POLICY_BUNDLE_V1"},
    "bundleId": {"type": "string", "minLength": 1},
    "bundleVersion": {"type": "string", "minLength": 1},
    "bundleDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "sourceRepository": {"type": "string", "minLength": 1},
    "sourceCommit": {"type": "string", "minLength": 1},
    "robotModel": {"const": "MICRODUCK"},
    "observationContract": {"$ref": "#/$defs/ObservationContract"},
    "actionContract": {"$ref": "#/$defs/ActionContract"},
    "model": {"$ref": "#/$defs/ModelArtifact"},
    "policies": {"type": "array", "items": {"$ref": "#/$defs/PolicyArtifact"}},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/ActionDefinition"}},
    "qualification": {"type": "object"},
    "license": {"type": "object"}
  },
  "$defs": {
    "Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "CompletionContract": {
      "type": "object", "additionalProperties": false,
      "required": ["terminalConditions", "maxDurationMs"],
      "properties": {
        "terminalConditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "maxDurationMs": {"type": "integer", "exclusiveMinimum": 0}
      }
    },
    "LeaseContract": {
      "type": "object", "additionalProperties": false,
      "x-unergy-invariants": ["minLeaseMs <= defaultLeaseMs <= maxLeaseMs", "commandCadenceMs <= minLeaseMs"],
      "required": ["minLeaseMs", "defaultLeaseMs", "maxLeaseMs", "commandCadenceMs"],
      "properties": {
        "minLeaseMs": {"type": "integer", "exclusiveMinimum": 0},
        "defaultLeaseMs": {"type": "integer", "exclusiveMinimum": 0},
        "maxLeaseMs": {"type": "integer", "exclusiveMinimum": 0},
        "commandCadenceMs": {"type": "integer", "exclusiveMinimum": 0},
        "safeStopBehavior": {"type": "string"}
      }
    },
    "ObservationContract": {
      "type": "object", "additionalProperties": false,
      "required": ["identifier", "dimension", "fields", "units", "normalization"],
      "properties": {
        "identifier": {"const": "MICRODUCK_OBS_61_V1"},
        "dimension": {"const": 61},
        "fields": {"type": "array", "minItems": 61, "maxItems": 61, "prefixItems": [
          {"const": "base_ang_vel.roll"}, {"const": "base_ang_vel.pitch"}, {"const": "base_ang_vel.yaw"},
          {"const": "projected_gravity.x"}, {"const": "projected_gravity.y"}, {"const": "projected_gravity.z"},
          {"const": "joint_pos_rel.left_hip_yaw"}, {"const": "joint_pos_rel.left_hip_roll"}, {"const": "joint_pos_rel.left_hip_pitch"}, {"const": "joint_pos_rel.left_knee"}, {"const": "joint_pos_rel.left_ankle"}, {"const": "joint_pos_rel.neck_pitch"}, {"const": "joint_pos_rel.head_pitch"}, {"const": "joint_pos_rel.head_yaw"}, {"const": "joint_pos_rel.head_roll"}, {"const": "joint_pos_rel.right_hip_yaw"}, {"const": "joint_pos_rel.right_hip_roll"}, {"const": "joint_pos_rel.right_hip_pitch"}, {"const": "joint_pos_rel.right_knee"}, {"const": "joint_pos_rel.right_ankle"},
          {"const": "joint_vel_rel.left_hip_yaw"}, {"const": "joint_vel_rel.left_hip_roll"}, {"const": "joint_vel_rel.left_hip_pitch"}, {"const": "joint_vel_rel.left_knee"}, {"const": "joint_vel_rel.left_ankle"}, {"const": "joint_vel_rel.neck_pitch"}, {"const": "joint_vel_rel.head_pitch"}, {"const": "joint_vel_rel.head_yaw"}, {"const": "joint_vel_rel.head_roll"}, {"const": "joint_vel_rel.right_hip_yaw"}, {"const": "joint_vel_rel.right_hip_roll"}, {"const": "joint_vel_rel.right_hip_pitch"}, {"const": "joint_vel_rel.right_knee"}, {"const": "joint_vel_rel.right_ankle"},
          {"const": "last_action.left_hip_yaw"}, {"const": "last_action.left_hip_roll"}, {"const": "last_action.left_hip_pitch"}, {"const": "last_action.left_knee"}, {"const": "last_action.left_ankle"}, {"const": "last_action.neck_pitch"}, {"const": "last_action.head_pitch"}, {"const": "last_action.head_yaw"}, {"const": "last_action.head_roll"}, {"const": "last_action.right_hip_yaw"}, {"const": "last_action.right_hip_roll"}, {"const": "last_action.right_hip_pitch"}, {"const": "last_action.right_knee"}, {"const": "last_action.right_ankle"},
          {"const": "twist.lin_vel_x"}, {"const": "twist.lin_vel_y"}, {"const": "twist.ang_vel_z"},
          {"const": "head_pose.neck_pitch"}, {"const": "head_pose.head_pitch"}, {"const": "head_pose.head_yaw"}, {"const": "head_pose.head_roll"},
          {"const": "body_pose.x"}, {"const": "body_pose.y"}, {"const": "body_pose.z"}, {"const": "body_pose.roll"}, {"const": "body_pose.pitch"}, {"const": "body_pose.yaw"}
        ]},
        "units": {"type": "object", "additionalProperties": {"type": "string"}},
        "normalization": {"enum": ["BAKED_IN_ONNX", "DECLARED"]}
      }
    },
    "ActionContract": {
      "type": "object", "additionalProperties": false,
      "required": ["identifier", "dimension", "joints", "units", "scaling", "clipping"],
      "properties": {
        "identifier": {"const": "MICRODUCK_ACTION_14_V1"},
        "dimension": {"const": 14},
        "joints": {"type": "array", "minItems": 14, "maxItems": 14, "prefixItems": [
          {"const": "left_hip_yaw"}, {"const": "left_hip_roll"}, {"const": "left_hip_pitch"}, {"const": "left_knee"}, {"const": "left_ankle"}, {"const": "neck_pitch"}, {"const": "head_pitch"}, {"const": "head_yaw"}, {"const": "head_roll"}, {"const": "right_hip_yaw"}, {"const": "right_hip_roll"}, {"const": "right_hip_pitch"}, {"const": "right_knee"}, {"const": "right_ankle"}
        ]},
        "units": {"type": "string"}, "scaling": {"type": "object"}, "clipping": {"type": "object"}
      }
    },
    "ModelArtifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "digest"],
      "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/Digest"}}
    },
    "PolicyArtifact": {
      "type": "object", "additionalProperties": false, "required": ["policyRef", "path", "digest", "runtimeRequirements"],
      "properties": {
        "policyRef": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/Digest"}, "taskId": {"type": ["string", "null"]},
        "runtimeRequirements": {"type": "object"}, "checkpoint": {"type": ["string", "null"]}, "experimentRef": {"type": ["string", "null"]}
      }
    },
    "ActionDefinition": {
      "type": "object", "additionalProperties": false,
      "required": ["actionCode", "executionMode", "availability", "parameterSchema"],
      "properties": {
        "actionCode": {"type": "string", "minLength": 1}, "executionMode": {"enum": ["DISCRETE", "CONTINUOUS_LEASE"]},
        "availability": {"enum": ["AVAILABLE", "UNAVAILABLE"]}, "policyRef": {"type": ["string", "null"]},
        "unavailableReason": {"type": ["string", "null"]}, "parameterSchema": {"type": "object"},
        "completion": {"anyOf": [{"$ref": "#/$defs/CompletionContract"}, {"type": "null"}]},
        "lease": {"anyOf": [{"$ref": "#/$defs/LeaseContract"}, {"type": "null"}]},
        "displayName": {"type": ["string", "null"]}, "description": {"type": ["string", "null"]},
        "localizedLabels": {"type": ["object", "null"], "additionalProperties": {"type": "string"}},
        "preconditions": {"type": ["object", "null"]}, "safety": {"type": ["object", "null"]},
        "qualificationRefs": {"type": ["array", "null"], "items": {"type": "string"}}
      },
      "allOf": [
        {"if": {"properties": {"availability": {"const": "AVAILABLE"}}, "required": ["availability"]}, "then": {"required": ["policyRef"], "properties": {"policyRef": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"executionMode": {"const": "CONTINUOUS_LEASE"}}, "required": ["executionMode"]}, "then": {"required": ["lease"], "properties": {"lease": {"$ref": "#/$defs/LeaseContract"}}}}
      ]
    },
    "SafeJsonValue": {"anyOf": [{"type": "string"}, {"type": "number"}, {"type": "boolean"}, {"type": "null"}, {"$ref": "#/$defs/SafeJsonObject"}, {"$ref": "#/$defs/SafeJsonArray"}]},
    "SafeJsonArray": {"type": "array", "items": {"$ref": "#/$defs/SafeJsonValue"}},
    "SafeJsonObject": {
      "type": "object",
      "propertyNames": {"not": {"pattern": "(?i:joint|torque|pwm|policypath|policyname)"}},
      "additionalProperties": {"$ref": "#/$defs/SafeJsonValue"}
    }
  }
}
