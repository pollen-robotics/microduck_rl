<mujoco model="world_parkour">
    <!-- PARKOUR world: full-collision robot + two staircases sized for a
         ~25cm/800g biped — a REGULAR straight staircase and a SPIRAL
         staircase, each with both an up and a down side (see README.md for
         how every dimension was chosen and how the geometry was generated).
         Both are solid box-stack stairs (each box spans floor to tread
         height), the same technique mjlab's own BoxPyramidStairsTerrainCfg
         uses, just hand-placed instead of procedurally generated — see
         complex/README.md "Going further" for the procedural alternative. -->
    <include file="robot_allcollisions.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
            height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3"
            markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
            reflectance="0.2" />
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

        <!-- ══════════════════════════════════════════════════════════════
             REGULAR STAIRCASE — straight flight along +X.
             riser=2cm, going(tread depth)=7cm, width=16cm, 6 steps up to a
             12cm platform (= the robot's own STAND_Z, one body-height climb),
             then 6 steps back down the far side. Generated by
             gen_regular_stairs() in README.md; every box spans the floor to
             its tread height (box-stack technique, same as mjlab's
             BoxPyramidStairsTerrainCfg). ═════════════════════════════════ -->
        <geom name="stair_up_1" type="box" size="0.0350 0.0800 0.0100" pos="0.3350 0 0.0100" rgba="0.55 0.45 0.35 1"/>
        <geom name="stair_up_2" type="box" size="0.0350 0.0800 0.0200" pos="0.4050 0 0.0200" rgba="0.55 0.45 0.35 1"/>
        <geom name="stair_up_3" type="box" size="0.0350 0.0800 0.0300" pos="0.4750 0 0.0300" rgba="0.55 0.45 0.35 1"/>
        <geom name="stair_up_4" type="box" size="0.0350 0.0800 0.0400" pos="0.5450 0 0.0400" rgba="0.55 0.45 0.35 1"/>
        <geom name="stair_up_5" type="box" size="0.0350 0.0800 0.0500" pos="0.6150 0 0.0500" rgba="0.55 0.45 0.35 1"/>
        <geom name="stair_up_6" type="box" size="0.0350 0.0800 0.0600" pos="0.6850 0 0.0600" rgba="0.55 0.45 0.35 1"/>
        <geom name="stair_platform" type="box" size="0.0500 0.0800 0.0600" pos="0.7700 0 0.0600" rgba="0.5 0.5 0.5 1"/>
        <geom name="stair_down_1" type="box" size="0.0350 0.0800 0.0500" pos="0.8550 0 0.0500" rgba="0.55 0.45 0.35 1"/>
        <geom name="stair_down_2" type="box" size="0.0350 0.0800 0.0400" pos="0.9250 0 0.0400" rgba="0.55 0.45 0.35 1"/>
        <geom name="stair_down_3" type="box" size="0.0350 0.0800 0.0300" pos="0.9950 0 0.0300" rgba="0.55 0.45 0.35 1"/>
        <geom name="stair_down_4" type="box" size="0.0350 0.0800 0.0200" pos="1.0650 0 0.0200" rgba="0.55 0.45 0.35 1"/>
        <geom name="stair_down_5" type="box" size="0.0350 0.0800 0.0100" pos="1.1350 0 0.0100" rgba="0.55 0.45 0.35 1"/>

        <!-- ══════════════════════════════════════════════════════════════
             SPIRAL STAIRCASE — center (0, 1.0), radius 18cm. riser=1cm,
             15deg/step (24 steps/full turn): ascends 180deg to a 12cm-high
             landing, then continues descending the remaining 180deg back to
             ground — one continuous loop with both up and down sides, exit
             ~35cm from entry along the circle. A thin center pole marks the
             axis (visual only, thin enough not to obstruct the treads).
             Generated by gen_spiral_stairs() in README.md. ═══════════════ -->
        <geom name="spiral_pole" type="cylinder" size="0.015 0.065" pos="0 1.0 0.065"
            rgba="0.35 0.35 0.35 1" contype="0" conaffinity="0" />

        <geom name="spiral_landing" type="box" size="0.045 0.045 0.0600" pos="-0.1800 1.0000 0.0600" euler="0 0 180.00" rgba="0.5 0.5 0.5 1"/>
        <geom name="spiral_1" type="box" size="0.0250 0.0200 0.0050" pos="0.1739 1.0466 0.0050" euler="0 0 15.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_2" type="box" size="0.0250 0.0200 0.0100" pos="0.1559 1.0900 0.0100" euler="0 0 30.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_3" type="box" size="0.0250 0.0200 0.0150" pos="0.1273 1.1273 0.0150" euler="0 0 45.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_4" type="box" size="0.0250 0.0200 0.0200" pos="0.0900 1.1559 0.0200" euler="0 0 60.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_5" type="box" size="0.0250 0.0200 0.0250" pos="0.0466 1.1739 0.0250" euler="0 0 75.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_6" type="box" size="0.0250 0.0200 0.0300" pos="0.0000 1.1800 0.0300" euler="0 0 90.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_7" type="box" size="0.0250 0.0200 0.0350" pos="-0.0466 1.1739 0.0350" euler="0 0 105.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_8" type="box" size="0.0250 0.0200 0.0400" pos="-0.0900 1.1559 0.0400" euler="0 0 120.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_9" type="box" size="0.0250 0.0200 0.0450" pos="-0.1273 1.1273 0.0450" euler="0 0 135.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_10" type="box" size="0.0250 0.0200 0.0500" pos="-0.1559 1.0900 0.0500" euler="0 0 150.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_11" type="box" size="0.0250 0.0200 0.0550" pos="-0.1739 1.0466 0.0550" euler="0 0 165.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_13" type="box" size="0.0250 0.0200 0.0550" pos="-0.1739 0.9534 0.0550" euler="0 0 195.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_14" type="box" size="0.0250 0.0200 0.0500" pos="-0.1559 0.9100 0.0500" euler="0 0 210.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_15" type="box" size="0.0250 0.0200 0.0450" pos="-0.1273 0.8727 0.0450" euler="0 0 225.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_16" type="box" size="0.0250 0.0200 0.0400" pos="-0.0900 0.8441 0.0400" euler="0 0 240.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_17" type="box" size="0.0250 0.0200 0.0350" pos="-0.0466 0.8261 0.0350" euler="0 0 255.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_18" type="box" size="0.0250 0.0200 0.0300" pos="-0.0000 0.8200 0.0300" euler="0 0 270.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_19" type="box" size="0.0250 0.0200 0.0250" pos="0.0466 0.8261 0.0250" euler="0 0 285.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_20" type="box" size="0.0250 0.0200 0.0200" pos="0.0900 0.8441 0.0200" euler="0 0 300.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_21" type="box" size="0.0250 0.0200 0.0150" pos="0.1273 0.8727 0.0150" euler="0 0 315.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_22" type="box" size="0.0250 0.0200 0.0100" pos="0.1559 0.9100 0.0100" euler="0 0 330.00" rgba="0.4 0.5 0.6 1"/>
        <geom name="spiral_23" type="box" size="0.0250 0.0200 0.0050" pos="0.1739 0.9534 0.0050" euler="0 0 345.00" rgba="0.4 0.5 0.6 1"/>
    </worldbody>
</mujoco>
