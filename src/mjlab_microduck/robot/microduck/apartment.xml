    <!-- ── Interactable objects scattered across rooms ──────────────────── -->
    <body name="obj_0" pos="-2.20 -1.20 0">
      <freejoint/>
      <geom name="obj_0_geom" type="box" size="0.035 0.035 0.035"
            pos="0 0 0.035" material="obj_red" contype="1" conaffinity="1" mass="0.05"/>
