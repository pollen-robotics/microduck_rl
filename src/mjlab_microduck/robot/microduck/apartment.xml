    <!-- Kitchen island (free-standing) -->
    <geom name="kit_island" type="box" size="0.40 0.30 0.20"
          pos="-2.20 1.40 0.20" material="counter_mat" contype="1" conaffinity="1"/>
    <!-- Stools at the island -->
    <geom name="kit_stool1" type="cylinder" size="0.10 0.18"
          pos="-2.70 0.95 0.18" material="metal_mat" contype="1" conaffinity="1"/>
    <geom name="kit_stool2" type="cylinder" size="0.10 0.18"
          pos="-1.70 0.95 0.18" material="metal_mat" contype="1" conaffinity="1"/>

    <!-- ── Living-room furniture (SW) ──────────────────────────────────── -->
    <!-- Sofa against west wall -->
    <geom name="liv_sofa_seat" type="box" size="0.20 0.55 0.16"
          pos="-3.78 -0.95 0.16" material="sofa" contype="1" conaffinity="1"/>
    <geom name="liv_sofa_back" type="box" size="0.06 0.55 0.22"
          pos="-3.94 -0.95 0.27" material="sofa" contype="1" conaffinity="1"/>
    <!-- Coffee table -->
    <geom name="liv_table" type="box" size="0.30 0.20 0.04"
          pos="-2.80 -1.00 0.18" material="table_wood" contype="1" conaffinity="1"/>
    <geom name="liv_table_l1" type="cylinder" size="0.018 0.08"
          pos="-3.07 -1.18 0.08" material="table_wood" contype="1" conaffinity="1"/>
    <geom name="liv_table_l2" type="cylinder" size="0.018 0.08"
          pos="-2.53 -1.18 0.08" material="table_wood" contype="1" conaffinity="1"/>
    <geom name="liv_table_l3" type="cylinder" size="0.018 0.08"
          pos="-3.07 -0.82 0.08" material="table_wood" contype="1" conaffinity="1"/>
    <geom name="liv_table_l4" type="cylinder" size="0.018 0.08"
          pos="-2.53 -0.82 0.08" material="table_wood" contype="1" conaffinity="1"/>
    <!-- TV stand against south wall -->
    <geom name="liv_tv_stand" type="box" size="0.50 0.10 0.20"
          pos="-2.50 -2.84 0.20" material="bookshelf_mat" contype="1" conaffinity="1"/>
    <!-- Tall bookshelf in SW corner -->
    <geom name="liv_shelf" type="box" size="0.10 0.30 0.40"
          pos="-3.85 -2.50 0.40" material="bookshelf_mat" contype="1" conaffinity="1"/>
    <geom name="liv_books" type="box" size="0.06 0.28 0.10"
          pos="-3.78 -2.50 0.36" rgba="0.80 0.28 0.10 1" contype="0" conaffinity="0"/>
    <!-- Floor lamp by sofa -->
    <geom name="liv_lamp_pole" type="cylinder" size="0.015 0.45"
          pos="-3.80 -0.30 0.45" material="table_wood" contype="1" conaffinity="1"/>
    <geom name="liv_lamp_shade" type="cylinder" size="0.10 0.07"
          pos="-3.80 -0.30 0.95" material="lamp_mat" contype="0" conaffinity="0"/>
    <!-- Armchair in middle -->
    <geom name="liv_chair_seat" type="box" size="0.20 0.20 0.16"
          pos="-2.10 0.05 0.16" material="sofa" contype="1" conaffinity="1"/>
    <geom name="liv_chair_back" type="box" size="0.20 0.06 0.20"
          pos="-2.10 -0.10 0.30" material="sofa" contype="1" conaffinity="1"/>
    <!-- Plant by corridor entrance -->
    <geom name="liv_plant" type="cylinder" size="0.10 0.30"
          pos="-1.20 -2.70 0.30" rgba="0.30 0.55 0.25 1" contype="1" conaffinity="1"/>

    <!-- ── Corridor furniture ──────────────────────────────────────────── -->
    <!-- Side console -->
    <geom name="cor_console" type="box" size="0.20 0.07 0.20"
          pos="-0.78 0.80 0.20" material="table_wood" contype="1" conaffinity="1"/>
    <!-- Coat rack (cylinder) -->
    <geom name="cor_coat_rack" type="cylinder" size="0.04 0.50"
          pos="-0.80 2.80 0.50" material="metal_mat" contype="1" conaffinity="1"/>
    <!-- Shoe rack -->
    <geom name="cor_shoes" type="box" size="0.20 0.07 0.10"
          pos="-0.80 -2.80 0.10" material="bookshelf_mat" contype="1" conaffinity="1"/>

    <!-- ── Bedroom furniture (NE) ──────────────────────────────────────── -->
    <!-- Bed -->
    <geom name="bed_base" type="box" size="0.55 0.40 0.10"
          pos="2.20 1.55 0.10" material="bed_mat" contype="1" conaffinity="1"/>
    <geom name="bed_pillow" type="box" size="0.18 0.10 0.04"
          pos="2.50 1.85 0.23" rgba="0.96 0.96 0.96 1" contype="0" conaffinity="0"/>
    <geom name="bed_blanket" type="box" size="0.45 0.30 0.02"
          pos="2.20 1.40 0.22" rgba="0.55 0.68 0.90 1" contype="0" conaffinity="0"/>
    <!-- Nightstands -->
    <geom name="bed_ns_l" type="box" size="0.15 0.15 0.20"
          pos="1.55 1.85 0.20" material="desk_mat" contype="1" conaffinity="1"/>
    <geom name="bed_ns_r" type="box" size="0.15 0.15 0.20"
          pos="2.85 1.85 0.20" material="desk_mat" contype="1" conaffinity="1"/>
    <!-- Wardrobe against east wall -->
    <geom name="bed_wardrobe" type="box" size="0.20 0.50 0.40"
          pos="3.74 2.30 0.40" material="bookshelf_mat" contype="1" conaffinity="1"/>
    <!-- Dresser against north wall -->
    <geom name="bed_dresser" type="box" size="0.30 0.10 0.24"
          pos="1.10 2.86 0.24" material="bookshelf_mat" contype="1" conaffinity="1"/>

    <!-- ── Office furniture (E centre) ─────────────────────────────────── -->
    <!-- Desk against east wall -->
    <geom name="off_desk" type="box" size="0.28 0.40 0.02"
          pos="3.66 0.00 0.36" material="desk_mat" contype="1" conaffinity="1"/>
    <geom name="off_desk_l1" type="box" size="0.018 0.018 0.17"
          pos="3.40 -0.36 0.17" material="desk_mat" contype="1" conaffinity="1"/>
    <geom name="off_desk_l2" type="box" size="0.018 0.018 0.17"
          pos="3.92 -0.36 0.17" material="desk_mat" contype="1" conaffinity="1"/>
    <geom name="off_desk_l3" type="box" size="0.018 0.018 0.17"
          pos="3.40  0.36 0.17" material="desk_mat" contype="1" conaffinity="1"/>
    <geom name="off_desk_l4" type="box" size="0.018 0.018 0.17"
          pos="3.92  0.36 0.17" material="desk_mat" contype="1" conaffinity="1"/>
    <!-- Office chair (cylinder, swivel-style) -->
    <geom name="off_chair" type="cylinder" size="0.18 0.20"
          pos="3.10 0.00 0.20" material="metal_mat" contype="1" conaffinity="1"/>
    <!-- Bookshelf against bedroom-wall side (y=+1) -->
    <geom name="off_shelf" type="box" size="0.40 0.10 0.42"
          pos="1.00 0.86 0.42" material="bookshelf_mat" contype="1" conaffinity="1"/>
