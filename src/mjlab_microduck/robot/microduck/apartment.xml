          pos="1.20 -0.78 0.32" rgba="0.30 0.55 0.25 1" contype="1" conaffinity="1"/>

    <!-- ── Bathroom furniture (SE) ─────────────────────────────────────── -->
    <!-- Bathtub against south + east walls -->
    <geom name="bth_tub" type="box" size="0.30 0.65 0.18"
          pos="3.65 -2.20 0.18" material="tub_mat" contype="1" conaffinity="1"/>
    <!-- Vanity / sink against west side (corridor wall side) -->
    <geom name="bth_vanity" type="box" size="0.20 0.25 0.30"
          pos="0.86 -1.40 0.30" material="counter_mat" contype="1" conaffinity="1"/>
    <geom name="bth_mirror" type="box" size="0.01 0.20 0.20"
          pos="0.66 -1.40 0.65" rgba="0.85 0.92 0.95 1" contype="0" conaffinity="0"/>
    <!-- Toilet -->
    <geom name="bth_toilet" type="cylinder" size="0.15 0.20"
          pos="1.30 -2.78 0.20" material="toilet_mat" contype="1" conaffinity="1"/>
    <!-- Towel rail against south wall -->
    <geom name="bth_rail" type="box" size="0.30 0.02 0.04"
          pos="2.50 -2.93 0.40" material="metal_mat" contype="0" conaffinity="0"/>

    <!-- ── Charging dock (SW corner of living room) ────────────────────── -->
    <body name="dock" pos="-3.80 -2.78 0">
      <geom name="dock_base"  type="box" size="0.16 0.16 0.012"
            pos="0 0 0.012" material="dock_mat" contype="0" conaffinity="0"/>
      <geom name="dock_panel" type="box" size="0.022 0.13 0.17"
            pos="0.14 0 0.18" material="dock_mat" contype="0" conaffinity="0"/>
      <geom name="dock_s1" type="box" size="0.005 0.11 0.012"
            pos="0.125 0 0.09" rgba="1 1 1 1" contype="0" conaffinity="0"/>
      <geom name="dock_s2" type="box" size="0.005 0.11 0.012"
            pos="0.125 0 0.19" rgba="1 1 1 1" contype="0" conaffinity="0"/>
