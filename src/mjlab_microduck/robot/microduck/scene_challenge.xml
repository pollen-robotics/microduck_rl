<mujoco model="scene">
    <!-- A challenge course for a 12 cm duck. Generated by scripts in the microduck session;
         edit freely, it is only geometry.

         Along +x from the origin, where the duck starts:
           0.35  a gate to walk through
           0.75  slalom, three posts 0.30 m apart
           2.10  a 0.40 m corridor, 0.8 m long
           2.90  a 5.7 degree ramp up to a 3 cm platform, a landing, then two steps down
           4.05  a 1.5 cm curb
           4.20  rubble: 8 mm plates to catch a dragging foot (a second patch at 4.90)
           4.55  a roll wall across the -y half, top at 5 cm; the +y half is the bypass gap
           5.00  a ball on a tee ring, and a goal at 5.55 to put it in

         Side rails at y +/-0.40 run the whole course, so a wandering duck stays in the room.

         `robot_allcollisions.xml`, not `robot_groundcontact.xml`: the duck has to hit the posts
         and walls, not pass through them. -->
    <include file="robot_allcollisions.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
            height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
            reflectance="0.2" />
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

        <geom name="rail_l" type="box" size="3.20 0.02 0.05" pos="2.8000 0.4000 0.0500" rgba="0.45 0.45 0.50 1"/>
        <geom name="rail_r" type="box" size="3.20 0.02 0.05" pos="2.8000 -0.4000 0.0500" rgba="0.45 0.45 0.50 1"/>
        <geom name="gate_l" type="cylinder" size="0.02 0.10" pos="0.3500 0.2200 0.1000" rgba="0.95 0.95 0.95 1"/>
        <geom name="gate_r" type="cylinder" size="0.02 0.10" pos="0.3500 -0.2200 0.1000" rgba="0.95 0.95 0.95 1"/>
        <geom name="slalom_0" type="cylinder" size="0.025 0.12" pos="0.7500 0.1300 0.1200" rgba="0.90 0.25 0.20 1"/>
        <geom name="slalom_1" type="cylinder" size="0.025 0.12" pos="1.0500 -0.1300 0.1200" rgba="0.90 0.25 0.20 1"/>
        <geom name="slalom_2" type="cylinder" size="0.025 0.12" pos="1.3500 0.1300 0.1200" rgba="0.90 0.25 0.20 1"/>
        <geom name="corridor_l" type="box" size="0.40 0.02 0.06" pos="2.1000 0.2200 0.0600" rgba="0.35 0.45 0.75 1"/>
        <geom name="corridor_r" type="box" size="0.40 0.02 0.06" pos="2.1000 -0.2200 0.0600" rgba="0.35 0.45 0.75 1"/>
        <geom name="ramp" type="box" size="0.1500 0.2500 0.0100" pos="2.9000 0.0000 0.0050" quat="0.998759 0 -0.049814 0" rgba="0.30 0.65 0.40 1"/>
        <geom name="platform" type="box" size="0.15 0.25 0.015" pos="3.2000 0.0000 0.0150" rgba="0.25 0.55 0.35 1"/>
        <geom name="step_0" type="box" size="0.05 0.25 0.0150" pos="3.4000 0.0000 0.0150" rgba="0.20 0.50 0.32 1"/>
        <geom name="step_1" type="box" size="0.05 0.25 0.0100" pos="3.5000 0.0000 0.0100" rgba="0.20 0.50 0.32 1"/>
        <geom name="step_2" type="box" size="0.05 0.25 0.0050" pos="3.6000 0.0000 0.0050" rgba="0.20 0.50 0.32 1"/>
        <geom name="curb" type="box" size="0.02 0.25 0.0075" pos="4.0500 0.0000 0.0075" rgba="0.95 0.75 0.20 1"/>
        <geom name="rollwall" type="box" size="0.025 0.175 0.025" pos="4.5500 -0.2250 0.0250" rgba="0.85 0.20 0.55 1"/>
        <geom name="rubble_0" type="box" size="0.03 0.03 0.004" pos="4.2000 0.0800 0.0040" rgba="0.55 0.50 0.45 1"/>
        <geom name="rubble_1" type="box" size="0.03 0.03 0.004" pos="4.2800 -0.1000 0.0040" rgba="0.55 0.50 0.45 1"/>
        <geom name="rubble_2" type="box" size="0.03 0.03 0.004" pos="4.3600 0.0200 0.0040" rgba="0.55 0.50 0.45 1"/>
        <geom name="rubble_3" type="box" size="0.03 0.03 0.004" pos="4.9000 -0.0600 0.0040" rgba="0.55 0.50 0.45 1"/>
