        0 0.08726646259971647 0.457924 0.004940 -0.452984"
        />
        <key name="SIT" qpos="
        0 0 0.07 1 0 0 0 
        0 0 -0.5236 1.0472 
        0 0.5 1.6 0 
        0 0 0 0.5236 -1.0472 0 5.0 0.0 0.035 1 0 0 0" ctrl="
        0 0 -0.5236 1.0472 0 
