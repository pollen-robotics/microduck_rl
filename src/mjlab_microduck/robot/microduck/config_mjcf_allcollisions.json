{
    "url": "https://cad.onshape.com/documents/804927696f06d877f3f1803e/w/5b75db19292e71970de02dee/e/ef6e972847fec8d82570b35e",
    "outputFormat": "mujoco",
    "robot_name": "microduck",
    "output_filename": "robot_allcollisions",
    "simplify_stls": true,
    "max_stl_size": 1.0,
    "additional_xml": [
        "joints_properties.xml",
        "sensors.xml",
        "additional.xml",
        "allcollisions_contacts.xml"
    ],
    "post_import_commands": [
        "sed -i 's/body name=\"trunk_base\" pos=\"[^\"]*\"/body name=\"trunk_base\" pos=\"0 0 0.12\"/' robot_allcollisions.xml",
        "sed -i '/<!-- Part sole_left -->/{n; n; s/class=\"collision\"/name=\"left_foot_collision\" class=\"collision\"/}' robot_allcollisions.xml",
        "sed -i '/<!-- Part sole_right -->/{n; n; s/class=\"collision\"/name=\"right_foot_collision\" class=\"collision\"/}' robot_allcollisions.xml",
        "sed -i '/<!-- Part power_support -->/{n; n; s/class=\"collision\"/class=\"self_collision_only\"/}' robot_allcollisions.xml",
        "sed -i 's/ inheritrange=\"1\"//g' robot_allcollisions.xml",
        "sed -i 's|<site[^>]*name=\"head_camera\"[^>]*pos=\"\\([^\"]*\\)\"[^>]*/>|&\\n              <camera name=\"head_camera\" pos=\"\\1\" quat=\"0 0 -1 0\"/>|' robot_allcollisions.xml"
    ],
    "joint_properties": {
        "default": {
            "class": "chosen_actuator"
        },
        "passive*": {
          "actuated": false,
          "class" : "passive_joint"
        }
    }
}