<mujoco model="microduck_launcher">
    <compiler angle="radian" autolimits="true"/>

    <worldbody>
        <!-- Launcher plate — the operator's hands. 18x18x2 cm, free-jointed.
             Its motion is PRESCRIBED every control step by the backflip_plate
             step event (pose + velocity rewritten), so the dynamics here only
             have to be well-conditioned, not realistic: the large mass keeps
             the intra-step deviation negligible while an 800 g duck pushes off.
             friction: high sliding friction so the pitch flick actually
             transfers backspin through the soles instead of slipping. -->
        <body name="plate" pos="0 0 0.15">
            <freejoint name="plate_free"/>
            <inertial pos="0 0 0" mass="50.0" diaginertia="0.5 0.5 1.0"/>
            <geom type="box" name="plate_geom" size="0.09 0.09 0.01"
                  rgba="0.35 0.35 0.4 1" friction="1.5 0.02 0.001"/>
        </body>
    </worldbody>
</mujoco>
